PORT=3000
NODE_ENV=development

# MongoDB (Atlas connection string or local: mongodb://localhost:27017/homesync)
MONGODB_URI=mongodb+srv://...

# JWT secrets (use long random strings, min 32 chars each)
JWT_SECRET=tu_secreto_muy_largo_aqui_min_32_chars
JWT_REFRESH_SECRET=otro_secreto_largo_aqui

# Access / refresh token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (local: redis://localhost:6379 or Redis Cloud URL)
REDIS_URL=redis://localhost:6379

# CORS: comma-separated allowed origins for production. Leave empty in dev to allow all.
CORS_ORIGINS=

# Flutter/Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
# NOTE: pubspec.lock IS tracked — this is an app, not a package (reproducible builds, TD-019)

# IDE
.idea/
.vscode/
*.iml

# Android
# NOTE (TD-036): native scaffolding IS versioned — gradlew, gradle/wrapper/,
# build.gradle, settings.gradle, AndroidManifest.xml, MainActivity, res/ — so
# the repo builds without running `flutter create` by hand. Only per-machine
# / generated-per-build artifacts are ignored below.
android/.gradle/
android/app/build/
android/.cxx/
android/local.properties
android/key.properties
android/app/google-services.json
*.keystore
*.jks
# flutter create (and future `flutter pub get`) writes a per-platform
# .gitignore under android/ and ios/ that re-ignores the very files this
# project deliberately tracks (gradlew, GeneratedPluginRegistrant.*). This
# repo's ignore rules live ONLY here; delete those nested files if they
# reappear rather than letting them silently fight this one.

# iOS
# NOTE (TD-036): native scaffolding IS versioned — Runner.xcodeproj/,
# Runner.xcworkspace/, AppDelegate*, Info.plist, Assets.xcassets, Base.lproj/,
# Podfile — so the repo builds without running `flutter create` by hand.
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Runner/GoogleService-Info.plist
**/DerivedData/

# macOS
.DS_Store

# iOS generated (do not track)
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Flutter/flutter_export_environment.sh
# NOTE: /ios/Pods/ already covered by the "ios/Pods/" rule above
# NOTE: ios/Runner/GeneratedPluginRegistrant.{h,m} are intentionally NOT ignored — Flutter convention is to track them

# Android generated (do not track)
/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
